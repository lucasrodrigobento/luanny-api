# =============================================================================
# nota-fiscal-api — template de variáveis de ambiente
# Copie para .env e preencha os valores reais.
# NUNCA versione .env com valores preenchidos.
#
# IMPORTANTE: credenciais de QIVE e UAU por empresa NÃO ficam aqui.
# Cada empresa (tenant) configura suas próprias integrações pela UI.
# Esses dados são persistidos no banco de dados.
# =============================================================================

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
PORT=8000
APP_ENV=desenvolvimento   # desenvolvimento | homologacao | producao

# -----------------------------------------------------------------------------
# Banco de dados
# Armazena configurações de integração por empresa (tenant)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://usuario:senha@localhost:5432/luany

# -----------------------------------------------------------------------------
# Autenticação (JWT)
# Usado para proteger os endpoints da API e identificar o tenant ativo
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# Multi-tenant — resolução de tenant
# Estratégia: subdomínio da requisição (ex: localiza.luany.com.br → slug "localiza")
# Em desenvolvimento local, usar header X-Tenant-Slug para simular
# -----------------------------------------------------------------------------
APP_BASE_DOMAIN=luany.com.br

# -----------------------------------------------------------------------------
# Configurações padrão de timeout para integrações externas
# Sobrescrevíveis por tenant no banco de dados se necessário
# -----------------------------------------------------------------------------
QIVE_TIMEOUT_MS=20000
UAU_TIMEOUT_MS=30000
UAU_AUTH_TIMEOUT_MS=20000
